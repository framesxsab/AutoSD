{
  "name": "autosd",
  "version": "0.7.0",
  "private": true,
  "description": "AutoSD — plugin-first tactile/research platform with DeviceManager, registry, DI hot-swap, and WCAG 2.2 AA guarantees",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.md\"",
    "test": "vitest run --coverage=false",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build",
    "prepare": "husky install 2>/dev/null || echo \"husky skip\""
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  }
}
