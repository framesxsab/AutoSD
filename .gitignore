# CodeGraph data files — local to each machine, not for committing.
.codegraph/*
!.codegraph/.gitignore
.omo/run-continuation/*
node_modules/
dist/
coverage/
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Corpus snapshots (generated)
corpus/snapshots/*/chunks.jsonl

# Build outputs (generated)
dist-app/

# Lighthouse report (generated by verify:release / lighthouse workflow)
lighthouse.json
lighthouse-*.json
lighthouse2.json

# Runtime corpus state (generated). A curated corpus/docs/ may still be committed.
corpus/index.json
corpus/sessions.json

# Evaluation artifacts (generated by `npm run evaluate`; share manually per docs)
evaluation-output/
